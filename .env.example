# Port configuration (for the local Express backend server)
PORT=5000

# SMTP Server Configurations
# If using Gmail, set SMTP_USER to your gmail and SMTP_PASS to an App Password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your email account credentials (SMTP user name and password)
# NEVER commit your actual credentials to git repos! Keep this .env file private.
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
